# ResearchForge Root Environment Variables Reference
# ===================================================
# This file lists all environment variables used across services.
# Copy specific values into individual service .env files:
#   - frontend/.env.local
#   - backend/.env
#   - ai-services/.env

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchforge?schema=public

# --- Backend API ---
BACKEND_PORT=4000
NODE_ENV=development

# --- AI Microservice ---
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# --- Frontend Web App ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
